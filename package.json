{
  "name": "equipment-booking-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Campus Equipment Booking API - Hono + TypeScript on Cloudflare Workers with a local D1 (SQLite) database, plus an AI support-request router on Workers AI",
  "scripts": {
    "dev": "wrangler dev",
    "dev:fallback": "wrangler dev --port 8789 --var ROUTER_MODEL:@cf/cloudflare/no-such-model",
    "dev:timeout": "wrangler dev --port 8790 --var ROUTER_TIMEOUT_MS:1",
    "db:migrate": "wrangler d1 migrations apply equipment-booking-db --local",
    "db:reset": "wrangler d1 execute equipment-booking-db --local --command \"DELETE FROM bookings; DELETE FROM support_tickets\"",
    "db:migrate:remote": "wrangler d1 migrations apply equipment-booking-db --remote",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node tests/run-tests.mjs",
    "test:support": "node tests/run-support-tests.mjs",
    "test:support:fallback": "node tests/run-support-tests.mjs http://localhost:8789/api --mode fallback --reason model_error",
    "test:support:timeout": "node tests/run-support-tests.mjs http://localhost:8790/api --mode fallback --reason model_timeout",
    "test:support:unit": "node tests/support-router.unit.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
