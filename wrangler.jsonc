{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equipment-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Fixed port so the local Base API URL is always http://localhost:8787/api
  "dev": { "port": 8787 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equipment-booking-db",
      // The deployed D1 database (created with `npx wrangler d1 create equipment-booking-db`).
      // `npm run dev` does not touch it: local development uses its own copy in .wrangler/.
      "database_id": "2eb3e2a7-4b54-4eba-aa15-c0aa0c3a0b2c",
      "migrations_dir": "migrations"
    }
  ]
}
