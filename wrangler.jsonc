{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equipment-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Fixed port so the Base API URL is always http://localhost:8787/api
  "dev": { "port": 8787 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equipment-booking-db",
      // Placeholder: enough for local development (wrangler dev keeps the data in .wrangler/).
      // Before deploying, replace it with the id printed by
      // `npx wrangler d1 create equipment-booking-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
