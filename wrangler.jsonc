{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equipment-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Fixed port so the local Base API URL is always http://localhost:8787/api
  "dev": { "port": 8787 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equipment-booking-db",
      // The deployed D1 database (created with `npx wrangler d1 create equipment-booking-db`).
      // `npm run dev` does not touch it: local development uses its own copy in .wrangler/.
      "database_id": "2eb3e2a7-4b54-4eba-aa15-c0aa0c3a0b2c",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI, used by the support-request router (assignment A6). The model runs on
  // Cloudflare, also during `npm run dev` ("remote"), and counts against the account's free
  // daily quota.
  "ai": { "binding": "AI", "remote": true },

  // Settings of the router. Override locally without editing this file:
  //   npx wrangler dev --var ROUTER_MODEL:@cf/cloudflare/no-such-model   (forces the fallback)
  "vars": {
    "ROUTER_MODEL": "@cf/cloudflare/clef",
    "ROUTER_TIMEOUT_MS": "8000",
    "ROUTER_MIN_CONFIDENCE": "0.6"
  }
}
